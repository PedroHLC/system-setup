// https://zed.dev/docs/configuring-zed
// https://github.com/zed-industries/zed/blob/main/assets/settings/default.json
{
  // Features Preferences
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Latte"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "bypassPermissions",
        "model": "default"
      },
      "type": "registry",
      "env": {
        "CLAUDE_CODE_EXECUTABLE": "direnv-claude"
      }
    }
  },
  "context_servers": {},
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "auto_update": false,
  "agent": {
    "dock": "left",
    "default_profile": "write",
    "play_sound_when_agent_done": "always",
    "default_model": {
      "enable_thinking": true,
      "provider": "openrouter",
      "model": "moonshotai/kimi-k2.6"
    },
    "button": true,
    "enabled": true,
    "max_content_width": 3840
  },
  "language_models": {
    "openai_compatible": {
      "llamacpp": {
        "api_url": "http://10.100.0.2:11435/v1",
        "available_models": [
          {
            "name": "Qwen3.5-35B-A3B-Q3_K_S.gguf",
            "display_name": "Qwen 3.5 35B (local)",
            "max_tokens": 32768,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": false,
              "prompt_cache_key": false
            }
          }
        ]
      }
    }
  },
  // UI Preferences
  "theme": {
    "mode": "dark",
    "light": "Catppuccin Latte",
    "dark": "Fleet Dark Purple"
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_family": "Borg Sans Mono",
  "buffer_font_size": 15,
  "preferred_line_length": 100,
  "wrap_guides": [
    50,
    98,
    100,
    150
  ],
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "tabs": {
    "git_status": true
  },
  "restore_on_startup": "launchpad",
  // Language preferences
  "load_direnv": "shell_hook",
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "Elixir": {
      "language_servers": [
        "expert",
        "!next-ls",
        "!elixir-ls"
      ],
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": [
            "format",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "Elm": {
      "formatter": {
        "external": {
          "command": "elm-format",
          "arguments": [
            "--stdin"
          ]
        }
      }
    },
    "JSON": {
      "format_on_save": "off",
      "language_servers": []
    }
  },
  "completions": {
    "lsp_fetch_timeout_ms": 250
  },
  // Remote stuff
  "ssh_connections": [
    {
      "host": "foreign",
      "args": [],
      "projects": [
        {
          "paths": [
            "~/Projects/co.timeline/calc-rs",
            "~/Projects/co.timeline/core",
            "~/Projects/co.timeline/devenv-nix"
          ]
        }
      ]
    },
    {
      "host": "desktop.vpn.internal",
      "args": [],
      "projects": [
        {
          "paths": [
            "/var/persistent/etc/nixos"
          ]
        }
      ]
    }
  ],
  // Disable shit
  "collaboration_panel": {
    "dock": "right",
    "button": false
  },
  "notification_panel": {
    "button": false
  }
}
