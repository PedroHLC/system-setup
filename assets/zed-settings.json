// https://zed.dev/docs/configuring-zed
{
  // Features Preferences
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_assistant": false
  },
  "auto_update": false,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "assistant": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-3-7-sonnet-latest"
    },
    "version": "2",
    "button": true,
    "enabled": true
  },
  // UI Preferences
  "theme": "Catppuccin Macchiato",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_family": "Borg Sans Mono",
  "buffer_font_size": 15,
  "preferred_line_length": 100,
  "wrap_guides": [
    50,
    98,
    100,
    150
  ],
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "tabs": {
    "git_status": true
  },
  "restore_on_startup": "none",
  // Language preferences
  "load_direnv": "shell_hook",
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "Elm": {
      "formatter": {
        "external": {
          "command": "elm-format",
          "arguments": [
            "--stdin"
          ]
        }
      },
      "language_servers": [
        "elm-language-server"
      ]
    },
    "JSON": {
      "format_on_save": "off",
      "language_servers": []
    }
  },
  // Remote stuff
  "ssh_connections": [
    {
      "host": "foreign",
      "projects": [
        {
          "paths": [
            "~/Projects/co.timeline/calc-rs",
            "~/Projects/co.timeline/core",
            "~/Projects/co.timeline/devenv-nix"
          ]
        }
      ]
    }
  ],
  // Disable shit
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  }
}
