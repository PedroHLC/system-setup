// https://zed.dev/docs/configuring-zed
// https://github.com/zed-industries/zed/blob/main/assets/settings/default.json
{
  // Features Preferences
  "agent_servers": {
    "claude": {}
  },
  "context_servers": {
    "mcp-server-figma": {
      "enabled": true,
      "remote": false,
      "settings": {}
    },
    "chrome-devtools-mcp-zed": {
      "enabled": true,
      "remote": false,
      "settings": {}
    }
  },
  "edit_predictions": {
    "provider": "zed",
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "auto_update": false,
  "agent": {
    "default_profile": "ask",
    "play_sound_when_agent_done": true,
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4"
    },
    "button": true,
    "enabled": true
  },
  // UI Preferences
  "theme": "Catppuccin Macchiato",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_family": "Borg Sans Mono",
  "buffer_font_size": 15,
  "preferred_line_length": 100,
  "wrap_guides": [
    50,
    98,
    100,
    150
  ],
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "tabs": {
    "git_status": true
  },
  "restore_on_startup": "launchpad",
  // Language preferences
  "load_direnv": "shell_hook",
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "Elixir": {
      "language_servers": [
        "expert",
        "!next-ls",
        "!elixir-ls"
      ],
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": [
            "format",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "Elm": {
      "formatter": {
        "external": {
          "command": "elm-format",
          "arguments": [
            "--stdin"
          ]
        }
      }
    },
    "HEEX": {
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": [
            "format",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "JSON": {
      "format_on_save": "off",
      "language_servers": []
    }
  },
  "completions": {
    "lsp_fetch_timeout_ms": 250
  },
  // Remote stuff
  "ssh_connections": [
    {
      "host": "foreign",
      "args": [],
      "projects": [
        {
          "paths": [
            "~/Projects/co.timeline/calc-rs",
            "~/Projects/co.timeline/core",
            "~/Projects/co.timeline/devenv-nix"
          ]
        }
      ]
    },
    {
      "host": "desktop.vpn",
      "args": [],
      "projects": [
        {
          "paths": [
            "/var/persistent/etc/nixos"
          ]
        }
      ]
    }
  ],
  // Disable shit
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  }
}
