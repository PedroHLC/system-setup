// https://zed.dev/docs/configuring-zed
// https://github.com/zed-industries/zed/blob/main/assets/settings/default.json
{
  // Features Preferences
  "context_servers": {
    "mcp-nixos": {
      "source": "custom",
      "enabled": false,
      "command": "nix",
      "args": [
        "run",
        "github:utensils/mcp-nixos",
        "--"
      ],
      "env": {}
    }
  },
  "edit_predictions": {
    "mode": "subtle",
    "copilot": {
      "proxy": null,
      "proxy_no_verify": null
    },
    "enabled_in_text_threads": false
  },
  "auto_update": false,
  "features": {
    "edit_prediction_provider": "zed"
  },
  "language_models": {
    "ollama": {
      "api_url": "http://10.100.0.2:11434",
      "available_models": [
        {
          "name": "gpt-oss:20b",
          "max_tokens": 7104,
          "keep_alive": "10m",
          "supports_tools": true,
          "supports_thinking": true
        }
      ]
    }
  },
  "agent": {
    "default_profile": "write",
    "play_sound_when_agent_done": true,
    "always_allow_tool_actions": false,
    "default_model": {
      "provider": "ollama",
      "model": "gpt-oss:20b"
    },
    "button": true,
    "enabled": true
  },
  // UI Preferences
  "theme": "Catppuccin Macchiato",
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_family": "Borg Sans Mono",
  "buffer_font_size": 15,
  "preferred_line_length": 100,
  "wrap_guides": [
    50,
    98,
    100,
    150
  ],
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto"
  },
  "tab_bar": {
    "show_nav_history_buttons": false
  },
  "tabs": {
    "git_status": true
  },
  "restore_on_startup": "none",
  // Language preferences
  //"load_direnv": "shell_hook",
  "format_on_save": "on",
  "formatter": "language_server",
  "languages": {
    "Elixir": {
      "language_servers": [
        "next-ls",
        "!elixir-ls"
      ],
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": [
            "format",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "Elm": {
      "formatter": {
        "external": {
          "command": "elm-format",
          "arguments": [
            "--stdin"
          ]
        }
      }
    },
    "HEEX": {
      "formatter": {
        "external": {
          "command": "mix",
          "arguments": [
            "format",
            "--stdin-filename",
            "{buffer_path}",
            "-"
          ]
        }
      }
    },
    "JSON": {
      "format_on_save": "off",
      "language_servers": []
    }
  },
  "completions": {
    "lsp_fetch_timeout_ms": 250
  },
  // Remote stuff
  "ssh_connections": [
    {
      "host": "foreign",
      "projects": [
        {
          "paths": [
            "~/Projects/co.timeline/calc-rs",
            "~/Projects/co.timeline/core",
            "~/Projects/co.timeline/devenv-nix"
          ]
        }
      ]
    }
  ],
  // Disable shit
  "collaboration_panel": {
    "button": false
  },
  "chat_panel": {
    "button": "never"
  },
  "notification_panel": {
    "button": false
  }
}
